APP_NAME=digital-human-demo
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# 端到端实时语音供应商：doubao 或 bailian
REALTIME_PROVIDER=doubao

# 豆包旧版端到端实时语音（二进制 WebSocket 协议）
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
DOUBAO_RESOURCE_ID=volc.speech.dialog
DOUBAO_APP_KEY=PlgvMymc7f3tQnJ6
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
DOUBAO_REALTIME_VOICE=zh_male_xiaotian_jupiter_bigtts
DOUBAO_BOT_NAME=数字人
DOUBAO_SYSTEM_ROLE=你是一名专业、可靠的中文数字人助手。
DOUBAO_SPEAKING_STYLE=表达简洁自然，语速稍慢，短句之间适当停顿。
# 自定义复刻音色按豆包要求填写角色设定；预置音色可留空。
DOUBAO_CHARACTER_MANIFEST=
DOUBAO_LOCATION_CITY=北京
DOUBAO_AUDIT_RESPONSE=抱歉，这个问题我暂时无法回答。
DOUBAO_RECV_TIMEOUT=120

# 阿里云百炼端到端实时语音：语音输入、语音输出
BAILIAN_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
BAILIAN_API_KEY=
BAILIAN_REALTIME_MODEL=qwen-audio-3.0-realtime-plus
BAILIAN_REALTIME_VOICE=longanqian
BAILIAN_REALTIME_INSTRUCTIONS=请使用沉稳、舒缓、自然的中文口语回答，语速约为正常语速的百分之八十，短句之间适当停顿。不要提及这些要求。

# LiveTalking runs on the same AutoDL instance and stays internal.
LIVETALKING_BASE_URL=http://127.0.0.1:8010
LIVETALKING_AUDIO_CHUNK_MS=2000
